install.packages("comtradr")
library(comtradr)
library(dplyr)
# Ejemplo: Descargar exportaciones/importaciones de bienes de México en 2022
datos_comercio <- ct_get_data(
type = "goods",
frequency = "A",                        # 'A' para Anual, 'M' para Mensual
commodity_classification = "HS",         # Sistema Armonizado
commodity_code = "TOTAL",               # "TOTAL" o un código específico (ej. "0901" para café)
reporter = "MEX",                       # Código ISO3 del país notificante (México)
partner = "World",                      # Socio comercial ("World" o ISO3 ej. "USA")
start_date = "2022",
end_date = "2022"
)
# Ejemplo: Descargar exportaciones/importaciones de bienes de México en 2022
datos_comercio <- ct_get_data(
type = "goods",
frequency = "A",                        # 'A' para Anual, 'M' para Mensual
commodity_classification = "HS",         # Sistema Armonizado
commodity_code = "TOTAL",               # "TOTAL" o un código específico (ej. "0901" para café)
reporter = "MEX",                       # Código ISO3 del país notificante (México)
partner = "World",                      # Socio comercial ("World" o ISO3 ej. "USA")
start_date = "2022",
end_date = "2022"
)
