library(httr2)
library(jsonlite)
# Endpoint público para datos anuales de mercancías
url <- "https://comtradeapi.un.org/public/v1/preview/C/A/HS"
req <- request(url) %>%
req_url_query(
reporterCode = 484,  # Código numérico ONU para México
period = "2022"
)
response <- req_perform(req)
